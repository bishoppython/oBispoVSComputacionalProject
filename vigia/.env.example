# Copie para .env e preencha. NUNCA commite o .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: sobrescreve camera.source do config.yaml (útil para não expor senha do RTSP no YAML)
# VIGIA_CAMERA_SOURCE=rtsp://usuario:senha@192.168.1.50:554/stream2
# VIGIA_SNAPSHOT_SOURCE=rtsp://usuario:senha@192.168.1.50:554/stream1

# ---- Nitro -> hub do homelab -------------------------------------------------
# Mesmo token nos dois lados. Gere com:  python -c "import secrets; print(secrets.token_urlsafe(32))"
VIGIA_HUB_TOKEN=
# Na Nitro, a fonte é o RTSP publicado pelo homelab:
# VIGIA_CAMERA_SOURCE=rtsp://192.168.1.108:8554/frente

# ---- Só no homelab ----------------------------------------------------------
# Caminho estável da webcam USB (ls -l /dev/v4l/by-id/), usado pelo docker-compose.homelab.yml
VIGIA_CAMERA_DEVICE=/dev/v4l/by-id/usb-EMEET_EMEET_SmartCam_S600_A260121000710025-video-index0

# WhatsApp via Evolution API (crie uma instância para o número novo e pareie pelo QR code)
EVOLUTION_URL=http://192.168.1.108:8081
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=vigia
# Destino: número com DDI+DDD (5511999998888) ou JID de grupo (1203...@g.us)
WHATSAPP_TO=

# Opcionais (valores padrão entre parênteses)
# HUB_RETENTION_DAYS=90            # apaga fotos/eventos mais antigos
# HUB_NODE_OFFLINE_AFTER_S=300     # sem heartbeat da Nitro -> "vigilância pausada"
# HUB_NOTIFY_NODE_STATUS=true      # avisar quando a Nitro desliga/volta
# HUB_REPORT_DAY=1                 # dia do relatório mensal
# HUB_REPORT_HOUR=8
